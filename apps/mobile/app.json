{
  "expo": {
    "name": "Kairo",
    "slug": "kairo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kairo",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D10",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daboggieman.kairo"
    },
    "android": {
      "package": "com.daboggieman.kairo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0D10"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-notifications",
      "expo-media-library",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Kairo to record your route during an active workout.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
