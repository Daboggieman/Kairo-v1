    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-location": "~57.0.11",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-sharing": "~57.0.13",
    "expo-speech": "~57.0.1",
