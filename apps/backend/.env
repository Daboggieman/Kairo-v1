# Kairo backend configuration.
#
# Copy to `.env` and adjust. Never commit the real `.env`.
# Following the tbot-v3 convention: all tunable parameters live here, not in code.

# --- Database ---
# Local dev without Docker falls back to SQLite (this is the default in config.py).
# With `docker compose -f infra/docker-compose.yml up -d postgres`, use Postgres:
# DATABASE_URL=postgresql+psycopg://kairo:kairo@localhost:5432/kairo
DATABASE_URL=sqlite:///./kairo.db
DEVICE_KEY=c09a6a880b1f320b0e8d1605ff6a408cd7ffe2e843d50a78373c53505edf58ac
JWT_SECRET=308f536d9c25e4f31d3361036beb7604003c678b2df87b973ece86a13424a60d

# --- API ---
API_V1_PREFIX=/api/v1
DEBUG=true

