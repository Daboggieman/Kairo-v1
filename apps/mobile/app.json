{
  "expo": {
    "name": "Kairo",
    "slug": "kairo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kairo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daboggieman.kairo"
    },
    "android": {
      "package": "com.daboggieman.kairo"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-notifications",
      "expo-media-library"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
