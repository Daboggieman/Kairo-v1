# --- Node / Expo (apps/mobile) ---
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo

# --- Python (apps/backend) ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Environment / secrets ---
# .env.example files ARE committed; real .env files are never committed.
.env
.env.*
!.env.example

# --- Native build output ---
# Managed workflow: android/ and ios/ are generated by `expo prebuild`.
/apps/mobile/android/
/apps/mobile/ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/
*.swp
